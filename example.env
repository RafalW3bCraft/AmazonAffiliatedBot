# ---------------------------------------------------------------------------
# AmazonAffiliatedBot / DealPilot - environment template.
# Copy to .env and fill in values. All values below are placeholders - no secrets.
# DEMO_MODE=true runs the web shop offline without any real credentials.
# ---------------------------------------------------------------------------

# REQUIRED for bot mode: Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# REQUIRED for posting: Telegram channel username, e.g. @my_channel.
TELEGRAM_CHANNEL=
# OPTIONAL: PostgreSQL connection URL for the deals DB. Empty -> in-memory fallback.
DATABASE_URL=
# OPTIONAL: individual PostgreSQL fields (alternative to DATABASE_URL).
PGDATABASE=
# OPTIONAL: PostgreSQL host.
PGHOST=
# OPTIONAL: PostgreSQL password.
PGPASSWORD=
# OPTIONAL: PostgreSQL user.
PGUSER=
# REQUIRED when ENABLE_EXTERNAL_AFFILIATE=true: Amazon Associates affiliate tag.
AMAZON_AFFILIATE_ID=
# OPTIONAL: OpenAI API key (takes priority when set).
OPENAI_API_KEY=
# OPTIONAL: Featherless API key (used when OPENAI_API_KEY is empty).
FEATHERLESS_API_KEY=
# OPTIONAL: Featherless API base URL.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# OPTIONAL: force AI provider ('openai'|'featherless'); empty = auto-detect from keys.
AI_PROVIDER=
# OPTIONAL: model name; defaults to gpt-4o-mini for OpenAI, required for Featherless.
AI_MODEL=
# REQUIRED to be 'sandbox': live PayPal is not supported.
PAYPAL_ENVIRONMENT=sandbox
# REQUIRED for merchant checkout: PayPal sandbox client ID.
PAYPAL_CLIENT_ID=
# REQUIRED for merchant checkout: PayPal sandbox client secret.
PAYPAL_CLIENT_SECRET=
# OPTIONAL: PayPal webhook ID for webhook signature verification.
PAYPAL_WEBHOOK_ID=
# OPTIONAL: PayPal order currency.
PAYPAL_CURRENCY=USD
# REQUIRED outside DEMO_MODE: strong random Flask session secret (>=16 chars).
FLASK_SECRET_KEY=
# OPTIONAL: bearer token protecting privileged dashboard/API routes.
DASHBOARD_TOKEN=
# RECOMMENDED for demo: run offline with the built-in catalog and no secrets.
DEMO_MODE=true
# OPTIONAL: enable the PayPal sandbox merchant checkout lane.
ENABLE_MERCHANT_CHECKOUT=true
# OPTIONAL: enable the Amazon external affiliate lane (needs AMAZON_AFFILIATE_ID).
ENABLE_EXTERNAL_AFFILIATE=false
# OPTIONAL: block unverified Amazon scraping sources.
DISABLE_UNVERIFIED_AMAZON_SCRAPING=true
# OPTIONAL: maximum allowed cart total (guardrail), in PAYPAL_CURRENCY units.
MAX_CART_TOTAL=500.00
# OPTIONAL: minutes a cart quote remains valid.
CART_QUOTE_TTL_MINUTES=30
# OPTIONAL: separate database for commerce/payment records (never the in-memory deals DB).
COMMERCE_DATABASE_URL=sqlite:///commerce.db
# OPTIONAL: comma-separated Telegram user IDs with admin access.
ADMIN_USER_IDS=
# OPTIONAL: default Amazon region (US, UK, DE, FR, CA, JP, AU, IN).
DEFAULT_REGION=US
