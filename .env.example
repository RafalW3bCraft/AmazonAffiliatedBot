# DealPilotAI — example environment configuration (NON-SECRET examples only)
# Copy to .env and fill in your own values. Never commit the real .env.

# ---- Required for any web session ----
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---- Lane B: merchant PayPal checkout (SANDBOX ONLY — live is refused by code) ----
# From https://developer.paypal.com/dashboard → Apps & Credentials → your SANDBOX app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From developer.paypal.com/dashboard → Webhooks → your sandbox webhook
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD

# Where PayPal redirects the buyer back (use https:// when publicly hosted)
APP_BASE_URL=http://127.0.0.1:5000

# ---- Lane B: durable commerce storage (payment records MUST persist; 'memory'/''
# is refused at startup) ----
# Local dev: COMMERCE_DATABASE_URL=sqlite:////absolute/path/dealpilot.db
# Production (e.g. Render Postgres): postgresql://user:pass@host:5432/dbname
COMMERCE_DATABASE_URL=

# ---- AI provider (pick one; no key = honest deterministic fallback) ----
AI_PROVIDER=openai            # or 'featherless'
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ---- Lane A: Telegram affiliate deal bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_channel
# Comma-separated integer Telegram user IDs, e.g. "123456789,987654321"
ADMIN_USER_IDS=
AMAZON_AFFILIATE_ID=

# ---- Lane A storage (legacy deal pipeline; Neon/Postgres) ----
DATABASE_URL=postgresql://user:password@host:5432/database

# ---- Feature flags ----
DEMO_MODE=false               # true = offline catalog-only demos, no secret needed
ENABLE_MERCHANT_CHECKOUT=true
ENABLE_EXTERNAL_AFFILIATE=true
DISABLE_UNVERIFIED_AMAZON_SCRAPING=true

# ---- Hardening ----
# Protects /api/users and merchant analytics; empty = those routes disabled
DASHBOARD_TOKEN=
CART_QUOTE_TTL_MINUTES=30
MAX_CART_TOTAL=10000

# ---- Server ----
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEFAULT_REGION=US
MAX_DEALS_PER_SOURCE=10
POST_INTERVAL_MINUTES=60
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=2
